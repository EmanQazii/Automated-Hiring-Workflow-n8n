    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\n// Detect role based on which fields exist\nconst role = item['Tech Stack'] !== undefined ? 'SWE' : 'BDM';\n\n// Generate unique candidate ID\nconst candidateId = 'CAND-' + Date.now() + '-' + Math.floor(Math.random() * 1000);\n\n// Standardize all fields\nconst cleaned = {\n  candidateId: candidateId,\n  name: item['Full Name'] || '',\n  email: item['Email'] || '',\n  phone: item['Phone Number'] || '',\n  role: role,\n  yearsOfExperience: item['Years of Experience'] || '',\n  resumeLink: item['Upload Your Resume'] || '',\n  processed: item['Processed'] || '',\n  rowNumber: item['row_number'],\n  \n  // SWE specific\n  techStack: item['Tech Stack'] || '',\n  githubProfile: item['GitHub Profile Link'] || '',\n  availableSWE: item['Are you available for a technical interview this week?'] || '',\n  \n  // BDM specific\n  industryBackground: item['Industry Background'] || '',\n  linkedinProfile: item['LinkedIn Profile URL'] || '',\n  availableBDM: item['Are you available for an interview this week?'] || '',\n};\n\nreturn cleaned;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        -48
      ],
      "id": "be5186a0-8d9b-4184-9f07-857ca1b71cef",
      "name": "Master Sheet"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\n// Extract file ID from Google Drive URL\nlet fileId = '';\nconst url = item.resumeLink;\n\nif (url && url !== 'empty') {\n  if (url.includes('open?id=')) {\n    fileId = url.split('open?id=')[1];\n  } else if (url.includes('/file/d/')) {\n    fileId = url.split('/file/d/')[1].split('/')[0];\n  }\n}\n\nreturn {\n  ...item,\n  fileId: fileId,\n  hasResume: fileId !== ''\n};"
      },
