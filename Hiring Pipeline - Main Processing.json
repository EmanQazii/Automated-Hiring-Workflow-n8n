    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mistralResponse = $input.item.json;\nconst candidateData = $('AI Prompt Generation').item.json;\n\nlet rawContent = mistralResponse.choices[0].message.content;\nrawContent = rawContent.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet aiResult;\ntry {\n  aiResult = JSON.parse(rawContent);\n} catch(e) {\n  aiResult = {\n    score: 0,\n    classification: \"average\",\n    summary: \"Could not parse AI response\",\n    strengths: [],\n    concerns: [],\n    interviewRecommended: false\n  };\n}\n\nreturn {\n  candidateId: candidateData.candidateId,\n  name: candidateData.name,\n  email: candidateData.email,\n  role: candidateData.role,\n  resumeLink: candidateData.resumeLink,\n  rowNumber: candidateData.rowNumber,\n  score: aiResult.score,\n  classification: aiResult.classification,\n  summary: aiResult.summary,\n  strengths: aiResult.strengths.join(', '),\n  concerns: aiResult.concerns.join(', '),\n  interviewRecommended: aiResult.interviewRecommended,\n  status: \"Pending Email\",\n  emailSent: \"No\",\n  timestamp: new Date().toISOString()\n};"
      },
